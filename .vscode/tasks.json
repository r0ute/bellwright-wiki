{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean generated docs",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-ChildItem -Path .\\docs -File -Filter *.md | Remove-Item -Force; if (Test-Path .\\docs\\assets) { Remove-Item -Recurse -Force .\\docs\\assets }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Generate docs",
      "type": "shell",
      "command": "python",
      "args": [
        ".\\generator\\generate.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Clean generated docs"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
